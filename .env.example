# ─────────────────────────────────────────────────────────────
# Buena Onda — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# From: https://supabase.com/dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Site ─────────────────────────────────────────────────────
# ── NestJS API ──────────────────────────────────────────
# Backend base URL (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

NEXT_PUBLIC_SITE_URL=https://your-site-domain.com

# Stripe
# From: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# ── Admin ────────────────────────────────────────────────────
# Password for /admin access gate. If unset, /admin is open (dev mode).
ADMIN_PASSWORD=change-me-in-production

# ── Studio (custom admin at /studio) ──────────────────────────
# Single email allowed to sign into /studio via Supabase Auth magic link.
# If unset, all sign-in attempts are silently rejected.
STUDIO_ALLOWED_EMAIL=you@example.com

# ── Anthropic (Claude AI — used by sync scripts) ──────────────
# From: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Email (Resend) ────────────────────────────────────────────
# From: https://resend.com → API Keys
# Required only if you want contact form emails to be delivered.
RESEND_API_KEY=re_your_api_key_here

# The inbox that receives contact form submissions
CONTACT_EMAIL=hello@buenaonda.com

# —— Cloudflare R2 / KV ———————————————————————————————————————————————————————————
# R2 bucket config for radio uploads / listings
CF_R2_BUCKET_NAME=your-r2-bucket-name
CF_R2_PUBLIC_URL=https://your-public-r2-url.example.com
CF_R2_ACCOUNT_ID=your-cloudflare-account-id
CF_R2_ACCESS_KEY_ID=your-r2-access-key-id
CF_R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Cloudflare KV metadata namespace for radio track ordering / title overrides
# Namespace title: BUENA_ONDA_RADIO_META
# Required for local dev because this repo does not use Wrangler bindings.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
BUENA_ONDA_RADIO_META_NAMESPACE_ID=your-kv-namespace-id

# Hero image source directory for the homepage / Studio homepage editor.
# If unset, the app falls back to public/images/hero in the project root.
# Relative paths are resolved from the repo root.
HERO_MEDIA_DIR=public/images/hero

